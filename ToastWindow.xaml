<Window x:Class="TopMediaBar.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Top Media Bar Toast"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Grid>
        <!-- A brief "now playing" toast — about a third the height of the full card —
             that flashes in on track change even when the cursor isn't at the top edge. -->
        <Grid x:Name="PopupSurface" VerticalAlignment="Top" HorizontalAlignment="Center"
              Opacity="0" RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
                <ScaleTransform ScaleY="0.97"/>
            </Grid.RenderTransform>
            <Grid.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5" Color="Black" Direction="270"/>
            </Grid.Effect>
            <Path Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="-16,0,0,0" Fill="#F2121212" IsHitTestVisible="False"
                  Data="M0,0 C8.84,0 16,7.16 16,16 L16,0 Z"/>
            <Path Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="0,0,-16,0" Fill="#F2121212" IsHitTestVisible="False"
                  Data="M16,0 C7.16,0 0,7.16 0,16 L0,0 Z"/>
        <Border x:Name="Bar" VerticalAlignment="Top"
                CornerRadius="0,0,14,14"
                Background="#F2121212"
                Padding="10">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="8" Background="#3A3A3C" ClipToBounds="True">
                    <Image x:Name="AlbumArt" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="12" FontWeight="Bold"
                               MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ArtistText" Foreground="#4A9EFF" FontSize="10" FontWeight="SemiBold"
                               Margin="0,2,0,0" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
